{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cinerelay.dev/schemas/normalized-raw-item.v1.json",
  "title": "CineRelay Normalized Raw Item v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceIdentityId",
    "canonicalUrl",
    "itemType",
    "contentFingerprint",
    "firstSeenAt"
  ],
  "properties": {
    "sourceIdentityId": {"type":"string","format":"uuid"},
    "platformItemId": {"type":["string","null"]},
    "canonicalUrl": {"type":"string","format":"uri"},
    "publishedAt": {"type":["string","null"],"format":"date-time"},
    "firstSeenAt": {"type":"string","format":"date-time"},
    "itemType": {"type":"string","minLength":1},
    "rawTitle": {"type":["string","null"]},
    "rawText": {"type":["string","null"]},
    "normalizedText": {"type":["string","null"]},
    "languageCode": {"type":["string","null"]},
    "mediaType": {"type":["string","null"]},
    "contentFingerprint": {"type":"string","minLength":1},
    "metadata": {"type":"object"}
  }
}
