{
  "name": "cinerelay",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:domain": "tsc -p packages/domain/tsconfig.json",
    "build:youtube": "tsc -p packages/youtube-connector/tsconfig.json",
    "build": "npm run build:domain && npm run build:youtube",
    "lint": "node scripts/repo-hygiene.mjs",
    "test:contracts": "npm run build && node scripts/validate-contracts.mjs",
    "test:benchmark": "npm run build && node tests/benchmark/run-benchmark.mjs",
    "test:youtube": "npm run build:youtube && node tests/youtube-connector/run-youtube-connector.mjs",
    "ci": "npm run lint && npm run test:contracts && npm run test:benchmark && npm run test:youtube"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
