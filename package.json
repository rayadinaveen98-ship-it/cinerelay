{
  "name": "cinerelay",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:domain": "tsc -p packages/domain/tsconfig.json",
    "build:youtube": "tsc -p packages/youtube-connector/tsconfig.json",
    "build:feed": "tsc -p packages/feed-connector/tsconfig.json",
    "build:web-page": "tsc -p packages/web-page-connector/tsconfig.json",
    "build:threads": "tsc -p packages/threads-connector/tsconfig.json",
    "build:instagram": "tsc -p packages/instagram-connector/tsconfig.json",
    "build:x": "tsc -p packages/x-connector/tsconfig.json",
    "build": "npm run build:domain && npm run build:youtube && npm run build:feed && npm run build:web-page && npm run build:threads && npm run build:instagram && npm run build:x",
    "lint": "node scripts/repo-hygiene.mjs",
    "test:contracts": "npm run build && node scripts/validate-contracts.mjs",
    "test:benchmark": "npm run build && node tests/benchmark/run-benchmark.mjs",
    "test:newsroom": "npm run build:domain && node tests/newsroom/run-newsroom-filter.mjs",
    "test:newsroom-state": "node tests/newsroom/run-newsroom-state-contract.mjs",
    "test:ott": "npm run build:domain && node tests/ott-intelligence/run-ott-release-signal.mjs",
    "test:push-presentation": "npm run build:domain && node tests/benchmark/run-push-presentation.mjs",
    "test:youtube": "npm run build:youtube && node tests/youtube-connector/run-youtube-connector.mjs && node tests/youtube-connector/run-youtube-planning.mjs",
    "test:feed": "npm run build:feed && node tests/feed-connector/run-feed-connector.mjs && node tests/feed-connector/run-processing-contract.mjs",
    "test:web-page": "npm run build:web-page && node tests/web-page-connector/run-web-page-connector.mjs",
    "test:threads": "npm run build:threads && node tests/threads-connector/run-threads-connector.mjs",
    "test:instagram": "npm run build:instagram && node tests/instagram-connector/run-instagram-connector.mjs",
    "test:x": "npm run build:x && node tests/x-connector/run-x-connector.mjs",
    "ci": "npm run lint && npm run test:contracts && npm run test:benchmark && npm run test:newsroom && npm run test:newsroom-state && npm run test:ott && npm run test:push-presentation && npm run test:youtube && npm run test:feed && npm run test:web-page && npm run test:threads && npm run test:instagram && npm run test:x"
  },
  "dependencies": {
    "fast-xml-parser": "5.10.1",
    "node-html-parser": "7.0.1"
  },
  "devDependencies": {
    "typescript": "5.8.3"
  }
}
